@startuml Diagrama de Casos de Uso Aether

left to right direction
skinparam packageStyle rectangle
skinparam backgroundColor #FFFFFF
skinparam actorBackgroundColor #E3F2FD
skinparam actorBorderColor #1976D2
skinparam usecaseBackgroundColor #E8F5E9
skinparam usecaseBorderColor #2E7D32

actor "Membro da Equipe\n(Member)" as member #LightBlue
actor "Gerente de Projeto\n(Manager)" as manager #LightGreen
actor "Administrador\n(Admin)" as admin #LightCoral
actor "Sistema WebSocket" as websocket #LightYellow

rectangle "Sistema Aether de Gestão de Tarefas" {

    package "Autenticação e Autorização" #F5F5F5 {
        usecase "UC01: Fazer Login" as UC01
        usecase "UC02: Fazer Logout" as UC02
        usecase "UC03: Registrar Usuário" as UC03
        usecase "UC04: Atualizar Perfil" as UC04
        usecase "UC05: Alterar Senha" as UC05
    }

    package "Gestão de Tarefas (Kanban)" #E8F5E9 {
        usecase "UC06: Visualizar Quadro Kanban" as UC06
        usecase "UC07: Criar Tarefa" as UC07
        usecase "UC08: Editar Tarefa" as UC08
        usecase "UC09: Excluir Tarefa" as UC09
        usecase "UC10: Mover Tarefa entre Colunas" as UC10
        usecase "UC11: Atribuir Tarefa a Usuário" as UC11
        usecase "UC12: Definir Prioridade da Tarefa" as UC12
        usecase "UC13: Definir Prazo da Tarefa" as UC13
        usecase "UC14: Filtrar e Buscar Tarefas" as UC14
        usecase "UC15: Visualizar Detalhes da Tarefa" as UC15
    }

    package "Gestão de Projetos" #E3F2FD {
        usecase "UC16: Criar Projeto" as UC16
        usecase "UC17: Editar Projeto" as UC17
        usecase "UC18: Excluir Projeto" as UC18
        usecase "UC19: Visualizar Lista de Projetos" as UC19
        usecase "UC20: Atribuir Equipe ao Projeto" as UC20
    }

    package "Colaboração" #FFF3E0 {
        usecase "UC21: Adicionar Comentário" as UC21
        usecase "UC22: Responder Comentário" as UC22
        usecase "UC23: Editar Comentário" as UC23
        usecase "UC24: Excluir Comentário" as UC24
        usecase "UC25: Mencionar Usuário (@)" as UC25
        usecase "UC26: Anexar Arquivo" as UC26
        usecase "UC27: Baixar Anexo" as UC27
        usecase "UC28: Excluir Anexo" as UC28
    }

    package "Notificações" #FCE4EC {
        usecase "UC29: Receber Notificações" as UC29
        usecase "UC30: Marcar Notificação como Lida" as UC30
        usecase "UC31: Visualizar Histórico" as UC31
    }

    package "Relatórios e Dashboard" #F3E5F5 {
        usecase "UC32: Visualizar Dashboard Pessoal" as UC32
        usecase "UC33: Gerar Relatório de Produtividade" as UC33
        usecase "UC34: Visualizar Gráfico Burndown" as UC34
        usecase "UC35: Exportar Relatório" as UC35
        usecase "UC36: Visualizar Tarefas Atrasadas" as UC36
    }

    package "Administração" #FFEBEE {
        usecase "UC37: Gerenciar Usuários" as UC37
        usecase "UC38: Gerenciar Equipes" as UC38
        usecase "UC39: Configurar Permissões" as UC39
        usecase "UC40: Visualizar Logs do Sistema" as UC40
        usecase "UC41: Realizar Backup" as UC41
    }
}

' Relacionamentos Member
member --> UC01
member --> UC02
member --> UC04
member --> UC05
member --> UC06
member --> UC10
member --> UC14
member --> UC15
member --> UC19
member --> UC21
member --> UC22
member --> UC23
member --> UC24
member --> UC25
member --> UC26
member --> UC27
member --> UC29
member --> UC30
member --> UC31
member --> UC32

' Relacionamentos Manager (herda de Member)
manager --|> member
manager --> UC07
manager --> UC08
manager --> UC09
manager --> UC11
manager --> UC12
manager --> UC13
manager --> UC16
manager --> UC17
manager --> UC18
manager --> UC20
manager --> UC28
manager --> UC33
manager --> UC34
manager --> UC35
manager --> UC36

' Relacionamentos Admin (herda de Manager)
admin --|> manager
admin --> UC03
admin --> UC37
admin --> UC38
admin --> UC39
admin --> UC40
admin --> UC41

' Sistema WebSocket
websocket --> UC29 : envia notificação
UC10 ..> websocket : <<trigger>>
UC21 ..> websocket : <<trigger>>
UC11 ..> websocket : <<trigger>>

' Relacionamentos include e extend
UC10 ..> UC06 : <<include>>
UC21 ..> UC15 : <<include>>
UC26 ..> UC15 : <<include>>
UC25 ..> UC29 : <<trigger>>
UC11 ..> UC29 : <<trigger>>

note right of UC29
  Notificações em tempo real
  via WebSocket quando:
  - Tarefa atribuída
  - Novo comentário
  - Menção no comentário
  - Prazo próximo
end note

note right of UC10
  Drag-and-drop no quadro Kanban
  com atualização em tempo real
  para todos os usuários
  conectados ao projeto
end note

note bottom of UC37
  Apenas administradores podem:
  - Criar novos usuários
  - Desativar usuários
  - Modificar permissões
  - Acessar logs do sistema
end note

note right of UC33
  Relatórios incluem:
  - Gráficos de burndown
  - Produtividade por membro
  - Taxa de conclusão
  - Tempo médio por tarefa
end note

@enduml
