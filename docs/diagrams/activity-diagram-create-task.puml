@startuml Diagrama de Atividade - Criar Nova Tarefa

skinparam backgroundColor #FFFFFF
skinparam activityBackgroundColor #E8F5E9
skinparam activityBorderColor #2E7D32
skinparam activityStartColor #4CAF50
skinparam activityEndColor #F44336
skinparam activityDiamondBackgroundColor #FFF3E0
skinparam activityDiamondBorderColor #FF9800
skinparam partitionBorderColor #1976D2
skinparam partitionBackgroundColor #E3F2FD

|Gerente/Manager|
start
:Acessa projeto no sistema;

:Clica em botão
"Nova Tarefa";

|Frontend|
:Exibe modal/formulário
de criação de tarefa;

|Gerente/Manager|
:Preenche dados da tarefa:
- Título (obrigatório)
- Descrição
- Prioridade
- Responsável
- Prazo
- Estimativa de horas;

:Clica em "Criar Tarefa";

|Frontend|
:Valida campos do formulário
com Zod schema;

if (Validação OK?) then (sim)
  :Envia requisição POST
  para /api/v1/tasks;

  |Backend API|
  :Recebe requisição POST;

  :Middleware de autenticação
  valida JWT token;

  if (Token válido?) then (sim)
    :Middleware de autorização
    verifica role do usuário;

    if (Role = Manager ou Admin?) then (sim)
      :Middleware de validação
      valida dados com Joi;

      if (Dados válidos?) then (sim)
        |Controller|
        :Chama TaskService.createTask();

        |Service|
        :Verifica se projeto existe;

        if (Projeto existe?) then (sim)
          if (Usuário tem acesso
          ao projeto?) then (sim)
            :Define created_by = userId;

            :Define position baseado
            em tarefas existentes;

            |Repository|
            :Inicia transação
            no PostgreSQL;

            :Executa INSERT na
            tabela tasks;

            :Confirma transação;

            :Retorna tarefa criada
            com ID gerado;

            |Service|
            if (Tarefa possui
            responsável?) then (sim)
              |Notification Service|
              :Cria notificação
              "task_assigned";

              :Salva no banco;

              |WebSocket Server|
              :Envia notificação em
              tempo real para usuário
              atribuído;
            endif

            :Emite evento "task:created"
            via WebSocket para projeto;

            |Controller|
            :Retorna HTTP 201
            com dados da tarefa;

            |Frontend|
            :Recebe resposta
            com tarefa criada;

            :Fecha modal;

            :Adiciona tarefa ao estado
            local (React Query);

            :Atualiza quadro Kanban
            inserindo tarefa na
            coluna "Ready";

            |Outros Usuários no Projeto|
            :Recebem evento WebSocket
            "task:created";

            :Atualizam quadro Kanban
            automaticamente;

            |Usuário Atribuído|
            if (Há responsável?) then (sim)
              :Recebe notificação
              em tempo real;

              :Ícone de notificação
              atualiza contador;
            endif

            |Gerente/Manager|
            :Visualiza nova tarefa
            no quadro Kanban;

            :Exibe mensagem de sucesso
            "Tarefa criada com sucesso";

            stop

          else (não)
            :Retorna erro 403
            "Sem acesso ao projeto";

            |Frontend|
            :Exibe mensagem de erro;
            stop
          endif

        else (não)
          :Retorna erro 404
          "Projeto não encontrado";

          |Frontend|
          :Exibe mensagem de erro;
          stop
        endif

      else (não)
        |Backend API|
        :Retorna erro 400
        com detalhes de validação;

        |Frontend|
        :Exibe erros nos campos
        do formulário;
        stop
      endif

    else (não)
      :Retorna erro 403
      "Sem permissão para criar tarefas";

      |Frontend|
      :Exibe mensagem de erro;
      stop
    endif

  else (não)
    :Retorna erro 401
    "Não autenticado";

    |Frontend|
    :Redireciona para login;
    stop
  endif

else (não)
  |Frontend|
  :Exibe erros de validação
  nos campos do formulário;

  :Destaca campos
  obrigatórios vazios;
  stop
endif

@enduml
